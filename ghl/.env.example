# Copia este archivo como ghl/.env (gitignored) y llena los valores.
# Token: GHL → Settings → Private Integrations → crear (solo scopes .readonly, ver README)
GHL_TOKEN=
# Location ID: GHL → Settings → Business Profile
GHL_LOCATION_ID=
# Opcional: versión de API (2021-07-28 por defecto; la doc nueva usa v3)
# GHL_API_VERSION=2021-07-28
